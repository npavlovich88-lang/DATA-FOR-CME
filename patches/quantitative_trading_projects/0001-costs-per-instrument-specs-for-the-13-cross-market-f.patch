+# --------------------------------------------------------------------------- cross-market
+# The 13 full-size futures behind the Yahoo `=F` continuous series used by the cross-market
+# project. Yahoo's front-month `=F` tickers are the FULL-SIZE contracts, not micros -- ES=F is
+# the $50 E-mini, not the $5 MES -- so these are the specs that turn a price change into dollars.
+#
+# WHAT IS PUBLISHED AND WHAT IS ASSUMED -- they are not the same quality of number
+#
+#   tick, point value   exchange contract specifications. Fixed, checkable, not in doubt.
+#   exchange fee        CME / ICE non-member rate per side, via broker pass-through schedules.
+#                       Re-verify; CME announced fee changes effective 2026-10-01.
+#   spread              ASSUMED, NOT MEASURED. There is no level-1 data for these 13 markets in
+#                       this project, unlike MES/MNQ above. Values are one tick for the deep
+#                       front months and TWO ticks wherever there is a reason to doubt one:
+#                         * 6E and 6J halved their minimum tick in 2019, so through the whole
+#                           2000-2014 train window one old tick = two current ticks;
+#                         * 6B is the thinnest of the three FX contracts;
+#                         * NG and HG front months are routinely wider than one tick outside
+#                           the most active hours, and HG's data is provisional anyway.
+#                       Early-2000s spreads on everything were wider than today. Report every
+#                       result at 1x AND at a cost multiple, never at 1x alone.
+#   slippage            none beyond the spread by default. No book data exists for these
+#                       markets; a measured table like SLIPPAGE_TICKS_BY_SIZE would be needed
+#                       before any size-dependent claim. Pass `slippage_ticks` to stress it.
+#
+# Price units must match Yahoo's quote convention or every P&L is off by a factor of 100:
+# SB is quoted in CENTS per lb (point value $1,120 per cent), HG in DOLLARS per lb, 6J in USD
+# per yen (~0.007), ZB/ZN in points of par with 32nds as decimals. `check_price_units` asserts
+# the series sits in the range the convention implies; run it on every load (standing check 15).
+
+
+@dataclass(frozen=True)
+class ContractSpec:
+    root: str
+    name: str
+    exchange: str
+    tick: float  # minimum price increment, in Yahoo quote units
+    point_value: float  # USD per 1.0 move in Yahoo quote units
+    spread_ticks: float  # ASSUMED typical front-month spread, see above
+    exchange_fee_per_side: float  # USD, non-member, exchange + clearing
+    quote_unit: str
+    price_range: tuple[float, float]  # plausible Yahoo closes 2000-2026, for the units check
+
+    @property
+    def tick_value(self) -> float:
+        return self.tick * self.point_value
+
+
+FUTURES_SPEC: dict[str, ContractSpec] = {
+    s.root: s
+    for s in (
+        # equity index ---------------------------------------------------------------- CME/CBOT
+        ContractSpec("ES", "E-mini S&P 500", "CME", 0.25, 50.0, 1, 1.38, "index pts", (500, 9_000)),
+        ContractSpec(
+            "NQ", "E-mini Nasdaq-100", "CME", 0.25, 20.0, 1, 1.38, "index pts", (700, 35_000)
+        ),
+        ContractSpec(
+            "RTY", "E-mini Russell 2000", "CME", 0.10, 50.0, 1, 1.38, "index pts", (800, 3_500)
+        ),
+        ContractSpec(
+            "YM", "E-mini Dow ($5)", "CBOT", 1.0, 5.0, 1, 1.38, "index pts", (5_000, 60_000)
+        ),
+        # rates ----------------------------------------------------------------------------- CBOT
+        ContractSpec(
+            "ZB", "30-year T-bond", "CBOT", 1 / 32, 1_000.0, 1, 0.87, "pts of par", (85, 210)
+        ),
+        ContractSpec(
+            "ZN", "10-year T-note", "CBOT", 1 / 64, 1_000.0, 1, 0.87, "pts of par", (85, 145)
+        ),
+        # energy --------------------------------------------------------------------------- NYMEX
+        ContractSpec("CL", "WTI crude oil", "NYMEX", 0.01, 1_000.0, 1, 1.60, "USD/bbl", (-45, 160)),
+        ContractSpec(
+            "NG", "Henry Hub natural gas", "NYMEX", 0.001, 10_000.0, 2, 1.60, "USD/MMBtu", (1, 17)
+        ),
+        # metals --------------------------------------------------------------------------- COMEX
+        ContractSpec("HG", "Copper", "COMEX", 0.0005, 25_000.0, 2, 1.60, "USD/lb", (0.5, 7)),
+        # FX --------------------------------------------------------------------------------- CME
+        ContractSpec("6E", "Euro FX", "CME", 0.00005, 125_000.0, 2, 1.60, "USD/EUR", (0.80, 1.65)),
+        ContractSpec(
+            "6B", "British pound", "CME", 0.0001, 62_500.0, 2, 1.60, "USD/GBP", (1.00, 2.15)
+        ),
+        ContractSpec(
+            "6J",
+            "Japanese yen",
+            "CME",
+            0.0000005,
+            12_500_000.0,
+            2,
+            1.60,
+            "USD/JPY",
+            (0.0055, 0.0140),
+        ),
+        # ags -------------------------------------------------------------------------- ICE US
+        ContractSpec(
+            "SB", "Sugar No. 11", "ICE US", 0.01, 1_120.0, 1, 2.00, "US cents/lb", (3, 40)
+        ),
+    )
+}
+
+FUTURES_PROVENANCE = {
+    "contract specs": "CME Group and ICE Futures U.S. contract specifications (tick, multiplier). "
+    "6J tick 0.0000005 and 6E tick 0.00005 are the post-2019 values.",
+    "exchange fees": "non-member per-side rates via broker pass-through schedules (TradeStation, "
+    "Interactive Brokers CME page), searched 2026-10-05; the CME and broker pages themselves were "
+    "unreachable from the research container, so these are search-snippet figures: E-mini equity "
+    "$1.38, Treasury $0.87 (ZB quoted, ZN assumed equal), NYMEX/COMEX $1.60 (CL quoted variously "
+    "$1.50/$1.60, $1.60 taken), FX $1.60 (6E quoted, 6B/6J assumed equal), ICE Sugar No. 11 "
+    "$2.00 screen fee (ICE 2016 schedule, the latest found). Verify at cmegroup.com/company/"
+    "clearing-fees.html and theice.com/fees -- CME changed fees effective 2026-10-01.",
+    "spread": "ASSUMED one or two ticks, not measured; see module notes.",
+}
+
+# A retail reference rate, NOT a default -- CostModel still refuses to choose a commission.
+# Interactive Brokers' fixed futures commission, $0.85 per contract per side, is the usual
+# benchmark a self-directed account would actually pay; tiered pricing runs lower at volume.
+# Named so that every result costed with it says so, and so it can be replaced in one place.
+REFERENCE_COMMISSION_PER_SIDE = 0.85
+REFERENCE_COMMISSION_PROVENANCE = (
+    "Interactive Brokers fixed-rate futures commission, $0.85/contract/side, ex exchange and "
+    "regulatory fees. A reference for an undecided account, not a rate anyone has agreed to."
+)
+
+POINT_VALUE.update({r: s.point_value for r, s in FUTURES_SPEC.items()})
+TICK_SIZE = {"MES": TICK, "MNQ": TICK, **{r: s.tick for r, s in FUTURES_SPEC.items()}}
+
+
+def root(symbol: str) -> str:
+    """'ES=F' -> 'ES'. Accepts the Yahoo ticker or the bare root."""
+    return symbol.upper().removesuffix("=F")
+
+
+def check_price_units(symbol: str, prices) -> None:
+    """Fail loudly if a price series is not in the units its point value assumes.
+
+    The failure this catches is silent and total: SB quoted in dollars instead of cents, or a
+    6J series quoted per 100 yen, would scale every P&L by 100 and nothing downstream would look
+    wrong. The median, not the extremes, is checked, so a few bad prints do not trip it.
+    """
+    spec = FUTURES_SPEC[root(symbol)]
+    p = np.asarray(prices, dtype=float)
+    p = p[np.isfinite(p)]
+    if not len(p):
+        raise ValueError(f"{symbol}: no finite prices to check")
+    lo, hi = spec.price_range
+    med = float(np.median(p))
+    if not lo <= med <= hi:
+        raise ValueError(
+            f"{symbol}: median price {med:g} outside {lo:g}..{hi:g} expected for "
+            f"{spec.quote_unit} -- point value ${spec.point_value:,.2f} would misprice every P&L"
+        )
+
+
 @dataclass(frozen=True)
 class CostModel:
     """Round-turn cost for one contract, decomposed.
@@ -187,7 +338,7 @@ class CostModel:
     contracts: int = 1  # drives the measured, size-dependent book-walk slippage
     spread_points: float | None = None  # None -> use the measured value
     slippage_ticks: float | None = None  # None -> measured for `contracts`; a float overrides
-    exchange_fee_per_side: float = EXCHANGE_FEE_PER_SIDE
+    exchange_fee_per_side: float | None = None  # None -> micro rate, or FUTURES_SPEC's
     nfa_fee_per_side: float = NFA_FEE_PER_SIDE
 
     @classmethod
@@ -204,22 +355,44 @@ class CostModel:
             comm = PROP_COMMISSION_PER_SIDE[firm]
         return cls(symbol=symbol, commission_per_side=comm, **kw)
 
+    @classmethod
+    def for_reference_broker(cls, symbol: str, **kw) -> CostModel:
+        """Cost model at REFERENCE_COMMISSION_PER_SIDE. Say so wherever the result is quoted."""
+        return cls(symbol=root(symbol), commission_per_side=REFERENCE_COMMISSION_PER_SIDE, **kw)
+
+    def __post_init__(self) -> None:
+        if self.symbol not in POINT_VALUE:
+            raise KeyError(f"no contract spec for {self.symbol!r}; pass the root, e.g. 'ES'")
+
     @property
     def point_value(self) -> float:
         return POINT_VALUE[self.symbol]
 
+    @property
+    def tick_size(self) -> float:
+        return TICK_SIZE[self.symbol]
+
+    @property
+    def exchange_fee(self) -> float:
+        if self.exchange_fee_per_side is not None:
+            return self.exchange_fee_per_side
+        if self.symbol in FUTURES_SPEC:
+            return FUTURES_SPEC[self.symbol].exchange_fee_per_side
+        return EXCHANGE_FEE_PER_SIDE
+
     @property
     def spread(self) -> float:
-        return (
-            MEASURED_SPREAD_POINTS[self.symbol]
-            if self.spread_points is None
-            else self.spread_points
-        )
+        if self.spread_points is not None:
+            return self.spread_points
+        if self.symbol in MEASURED_SPREAD_POINTS:
+            return MEASURED_SPREAD_POINTS[self.symbol]
+        spec = FUTURES_SPEC[self.symbol]
+        return spec.spread_ticks * spec.tick
 
     @property
     def fees_usd(self) -> float:
         """Commission + exchange + regulatory, both sides."""
-        return 2 * (self.commission_per_side + self.exchange_fee_per_side + self.nfa_fee_per_side)
+        return 2 * (self.commission_per_side + self.exchange_fee + self.nfa_fee_per_side)
 
     @property
     def spread_usd(self) -> float:
@@ -230,12 +403,14 @@ class CostModel:
     def slippage_per_side_ticks(self) -> float:
         if self.slippage_ticks is not None:
             return self.slippage_ticks
+        if self.symbol not in SLIPPAGE_TICKS_BY_SIZE:
+            return 0.0  # unmeasured for this market; stress it via slippage_ticks
         return slippage_ticks_for_size(self.symbol, self.contracts)
 
     @property
     def slippage_usd(self) -> float:
         """Per contract, both sides. Charged on top of the spread, never instead of it."""
-        return 2 * self.slippage_per_side_ticks * TICK * self.point_value
+        return 2 * self.slippage_per_side_ticks * self.tick_size * self.point_value
 
     @property
     def round_turn_usd(self) -> float:
@@ -250,9 +425,9 @@ class CostModel:
         p = self.point_value
         rows = [
             ("commission", 2 * self.commission_per_side),
-            ("exchange fee", 2 * self.exchange_fee_per_side),
+            ("exchange fee", 2 * self.exchange_fee),
             ("NFA fee", 2 * self.nfa_fee_per_side),
-            (f"spread ({self.spread:.2f} pts)", self.spread_usd),
+            (f"spread ({self.spread / self.tick_size:g} tk)", self.spread_usd),
         ]
         if self.slippage_usd:
             rows.append(
@@ -263,13 +438,37 @@ class CostModel:
             )
         w = max(len(r[0]) for r in rows)
         out = [f"{self.symbol} round-turn cost, 1 contract (point value ${p:.2f})"]
-        out += [f"  {n:<{w}}  ${v:>6.2f}   {v / p:>6.3f} pts" for n, v in rows]
+        out += [f"  {n:<{w}}  ${v:>6.2f}   {v / self.tick_size / p:>6.3f} tk" for n, v in rows]
         out.append(
-            f"  {'TOTAL':<{w}}  ${self.round_turn_usd:>6.2f}   {self.round_turn_points:>6.3f} pts"
+            f"  {'TOTAL':<{w}}  ${self.round_turn_usd:>6.2f}   "
+            f"{self.round_turn_points / self.tick_size:>6.3f} tk"
         )
         return "\n".join(out)
 
 
+def futures_cost_table(commission_per_side: float = REFERENCE_COMMISSION_PER_SIDE) -> pd.DataFrame:
+    """One row per cross-market contract: specs and the round-turn cost they imply."""
+    rows = []
+    for r, s in FUTURES_SPEC.items():
+        c = CostModel(symbol=r, commission_per_side=commission_per_side)
+        rows.append(
+            dict(
+                root=r,
+                exchange=s.exchange,
+                tick=s.tick,
+                point_value=s.point_value,
+                tick_value=s.tick_value,
+                spread_ticks=s.spread_ticks,
+                spread_usd=c.spread_usd,
+                fees_rt_usd=c.fees_usd,
+                commission_rt_usd=2 * commission_per_side,
+                round_turn_usd=c.round_turn_usd,
+                round_turn_ticks=c.round_turn_points / s.tick,
+            )
+        )
+    return pd.DataFrame(rows).set_index("root")
+
+
