@@ -0,0 +1,104 @@
+"""Cross-market contract specs: the numbers every futures P&L is multiplied by."""
+
+import numpy as np
+import pytest
+
+from quant.costs import (
+    EXCHANGE_FEE_PER_SIDE,
+    FUTURES_SPEC,
+    MEASURED_SPREAD_POINTS,
+    POINT_VALUE,
+    REFERENCE_COMMISSION_PER_SIDE,
+    CostModel,
+    check_price_units,
+    futures_cost_table,
+    root,
+)
+
+THIRTEEN = {"RTY", "ES", "CL", "ZB", "NQ", "SB", "ZN", "YM", "NG", "6E", "6B", "6J", "HG"}
+
+
+def test_all_thirteen_markets_have_a_spec():
+    assert set(FUTURES_SPEC) == THIRTEEN
+
+
+@pytest.mark.parametrize(
+    ("sym", "tick_value"),
+    [
+        # published exchange tick values -- if one of these drifts, the spec table is wrong
+        ("ES", 12.50),
+        ("NQ", 5.00),
+        ("RTY", 5.00),
+        ("YM", 5.00),
+        ("ZB", 31.25),
+        ("ZN", 15.625),
+        ("CL", 10.00),
+        ("NG", 10.00),
+        ("HG", 12.50),
+        ("6E", 6.25),
+        ("6B", 6.25),
+        ("6J", 6.25),
+        ("SB", 11.20),
+    ],
+)
+def test_tick_values_match_the_exchange(sym, tick_value):
+    assert FUTURES_SPEC[sym].tick_value == pytest.approx(tick_value)
+
+
+def test_yahoo_tickers_resolve_to_roots():
+    assert root("ES=F") == "ES"
+    assert root("6j=f") == "6J"
+    c = CostModel.for_reference_broker("CL=F")
+    assert c.symbol == "CL"
+    assert c.commission_per_side == REFERENCE_COMMISSION_PER_SIDE
+
+
+def test_commission_still_has_no_default_for_futures():
+    with pytest.raises(TypeError):
+        CostModel(symbol="ES")  # type: ignore[call-arg]
+
+
+def test_unknown_symbol_fails_at_construction():
+    with pytest.raises(KeyError):
+        CostModel(symbol="ES=F", commission_per_side=0.85)
+
+
+def test_futures_use_their_own_tick_and_exchange_fee():
+    c = CostModel(symbol="ZN", commission_per_side=0.0, nfa_fee_per_side=0.0)
+    assert c.tick_size == pytest.approx(1 / 64)
+    assert c.fees_usd == pytest.approx(2 * 0.87)
+    assert c.spread_usd == pytest.approx(15.625)
+    s = CostModel(symbol="ZN", commission_per_side=0.0, slippage_ticks=1.0)
+    assert s.slippage_usd == pytest.approx(2 * 15.625)
+
+
+def test_unmeasured_markets_carry_no_hidden_slippage():
+    assert CostModel(symbol="ES", commission_per_side=0.85, contracts=50).slippage_usd == 0.0
+
+
+def test_micros_are_unchanged():
+    """The MES/MNQ model must not move when the futures table is added."""
+    for sym in ("MES", "MNQ"):
+        c = CostModel(symbol=sym, commission_per_side=0.5)
+        assert c.spread == MEASURED_SPREAD_POINTS[sym]
+        assert c.exchange_fee == EXCHANGE_FEE_PER_SIDE
+        assert c.tick_size == 0.25
+    assert POINT_VALUE["MES"] == 5.0
+    assert POINT_VALUE["MNQ"] == 2.0
+
+
+def test_cost_table_components_sum():
+    t = futures_cost_table()
+    assert set(t.index) == THIRTEEN
+    np.testing.assert_allclose(t.round_turn_usd, t.spread_usd + t.fees_rt_usd)
+    # every market costs at least one tick plus fees -- the floor is the spread
+    assert (t.round_turn_ticks > 1.0).all()
+
+
+def test_units_check_catches_a_factor_of_100():
+    check_price_units("SB=F", [18.5, 19.0, 21.2])  # cents/lb: fine
+    with pytest.raises(ValueError, match="SB"):
+        check_price_units("SB=F", [0.185, 0.19, 0.212])  # dollars/lb: P&L off by 100x
+    check_price_units("6J", [0.0067, 0.0091])
+    with pytest.raises(ValueError, match="6J"):
+        check_price_units("6J", [0.67, 0.91])  # per-100-yen quote
